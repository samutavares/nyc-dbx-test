    {
      "name": "hourly_service_trips",
      "displayName": "Hourly Trips by Service Type",
      "queryLines": [
        "SELECT\n",
        "  t2.description AS service_type,\n",
        "  HOUR(t1.pickup_datetime) AS pickup_hour,\n",
        "  COUNT(*) AS trip_count\n",
        "FROM\n",
        "  nyc_taxi.gold.fact_trips t1\n",
        "    JOIN nyc_taxi.gold.dim_service_type t2\n",
        "      ON t1.service_type_key = t2.service_type_key\n",
        "GROUP BY\n",
        "  t2.description,\n",
        "  HOUR(t1.pickup_datetime)\n",
        "ORDER BY\n",
        "  t2.description,\n",
        "  trip_count DESC"
      ]
    },
    {
      "name": "549b9203",
      "displayName": "fact_trips",
      "config": {
        "version": "1.1",
        "source": "nyc_taxi.gold.fact_trips",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Representa o número total de linhas no conjunto de dados. Use essa medida para contar todos",
            "displayName": "Contagem"
          }
        ]
      }
    },
    {
      "name": "trips_by_zone",
      "displayName": "Trips by Zone",
      "queryLines": [
        "SELECT\n",
        "  z.zone,\n",
        "  z.borough,\n",
        "  COUNT(*) AS trip_count,\n",
        "  ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 2) AS trip_pct\n",
        "FROM\n",
        "  nyc_taxi.gold.fact_trips t\n",
        "    JOIN nyc_taxi.gold.dim_zone z\n",
        "      ON t.pickup_zone_key = z.zone_key\n",
        "GROUP BY\n",
        "  z.zone,\n",
        "  z.borough\n",
        "ORDER BY\n",
        "  trip_count DESC"
      ]
    }
  ],
