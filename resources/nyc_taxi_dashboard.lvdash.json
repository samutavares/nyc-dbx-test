{
  "datasets": [
    {
      "name": "d1d90e67",
      "displayName": "Conjunto de dados sem título",
      "queryLines": [
        "-- Calculate % of airport trips per service_type\r\n",
        "SELECT\r\n",
        "  t2.description,\r\n",
        "  COUNT(*) AS airport_trip_count,\r\n",
        "  ROUND(100.0 * COUNT(*) / SUM(COUNT(*)) OVER (), 2) AS airport_trip_pct\r\n",
        "FROM nyc_taxi.gold.fact_trips t1\r\n",
        "join nyc_taxi.gold.dim_service_type t2 on t1.service_type_key=t2.service_type_key\r\n",
        "WHERE is_airport_trip = true\r\n",
        "GROUP BY t2.description\r\n",
        "ORDER BY airport_trip_pct DESC"
      ]
    },
